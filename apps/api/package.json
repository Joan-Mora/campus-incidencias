{
  "name": "@campus/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./uploads src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:once": "tsx prisma/seed.ts --if-empty",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed",
    "simulate": "tsx src/scripts/simulate.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@campus/shared": "*",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.1.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "natural": "^8.1.0",
    "node-cron": "^3.0.3",
    "sharp": "^0.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.3"
  }
}
