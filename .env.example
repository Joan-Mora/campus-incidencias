# Base de datos (docker compose expone Postgres en 5434 (5432 y 5433 suelen estar ocupados por Postgres locales))
DATABASE_URL=postgresql://campus:campus@localhost:5434/campus?schema=public

# API
NODE_ENV=development
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Origenes permitidos separados por coma. En desarrollo tambien se aceptan IPs de la red local.
CORS_ORIGIN=http://localhost:5173
# Login rapido por rol para la demo. Nunca activar en produccion real.
ALLOW_DEV_LOGIN=true

# Reloj del SLA: 1 = tiempo real, 60 = una hora pasa en un minuto
SLA_TIME_SCALE=1

# Similitud semantica local con transformers.js (requiere instalar @huggingface/transformers)
SIMILARITY_EMBEDDINGS=off

# Almacenamiento de evidencias: local | database
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Front: vacio = usa el proxy de Vite (/api y /ws)
VITE_API_URL=
